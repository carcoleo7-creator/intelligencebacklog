# ── Database (auto-filled by Vercel ↔ Supabase integration) ─────────────────
# Pooled connection for app queries (PgBouncer)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection required by Prisma for migrations
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32   OR   https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Google OAuth (for user sign-in dashboard access) ─────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Anthropic (AI classification and scoring) ─────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Webhook security ──────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32   OR any random string generator
# Add as Authorization: Bearer <value> header in Zapier/Slack Workflow
WEBHOOK_SECRET="your-webhook-secret-here"
